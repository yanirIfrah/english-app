{
  "functions": {
    "api/admin.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "",
  "redirects": [
    {
      "source": "/((?!gone\\.html).*)",
      "has": [
        {
          "type": "host",
          "value": "english-app-alpha-six.vercel.app"
        }
      ],
      "destination": "/gone.html",
      "permanent": false
    }
  ]
}